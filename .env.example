# Database (Neon Postgres - free)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/nexsend?sslmode=require

# Auth
JWT_SECRET=change-me-to-a-long-random-string-32-chars-min

# Storage (Cloudflare R2 - 10GB free, no egress fees)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=nexsend-files

# First admin (hardcoded per request - CHANGE AFTER DEPLOY)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_DISPLAY_NAME=Administrator

# Cleanup cron
CRON_SECRET=another-long-random-string

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local development only (ignored when DATABASE_URL is set)
# PGLITE_DIR=./.local/pglite
# LOCAL_STORAGE_DIR=./.local/uploads
